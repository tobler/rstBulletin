@if (PageCount > 1)
{
    <nav class="pager" aria-label="Seiten">
        @if (Page > 1)
        {
            <a href="@Href(Page - 1)" aria-label="Vorherige Seite" rel="prev"><Icon Name="chevron-left" Size="16" /></a>
        }
        @foreach (var p in Pages())
        {
            if (p == 0) { <span class="gap">…</span> }
            else if (p == Page) { <a href="@Href(p)" class="on" aria-current="page">@p</a> }
            else { <a href="@Href(p)">@p</a> }
        }
        @if (Page < PageCount)
        {
            <a href="@Href(Page + 1)" aria-label="Nächste Seite" rel="next"><Icon Name="chevron-right" Size="16" /></a>
        }
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter, EditorRequired] public Func<int, string> Href { get; set; } = p => "?page=" + p;

    private IEnumerable<int> Pages()
    {
        var set = new SortedSet<int> { 1, PageCount };
        for (int i = Page - 2; i <= Page + 2; i++) if (i >= 1 && i <= PageCount) set.Add(i);
        int last = 0;
        foreach (var p in set)
        {
            if (last > 0 && p - last > 1) yield return 0;
            yield return p;
            last = p;
        }
    }
}
