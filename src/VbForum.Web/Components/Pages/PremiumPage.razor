@page "/premium"
@inject BoardCache Cache
@inject CurrentUser Current
@inject PremiumService Premium
@inject RstPayService RstPay
@inject NavigationManager Nav

<PageTitle>Premium – @_snap?.Settings.BoardName</PageTitle>

@if (!_loaded) { return; }
<main class="page container">
    <div class="page-head"><div><h1>Premium-Mitgliedschaft</h1><p>Voller Zugang zu allen Premium-Bereichen des Forums.</p></div></div>

    @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-err" role="alert">@Error</div> }
    @if (_cancelMsg != null) { <div class="alert @(CancelQ is "ok" or "already" ? "alert-ok" : "alert-err")" role="status">@_cancelMsg</div> }
    @if (Done == "1")
    {
        <div class="alert alert-ok" role="status">Danke für deine Buchung! Sobald rstpay die Zahlung bestätigt, wird dein Zugang freigeschaltet – meist innerhalb weniger Sekunden. Lade die Seite bei Bedarf neu.</div>
    }

    @if (_active.Count > 0)
    {
        <section class="card card-pad stack">
            <h2 class="card-title" style="margin:0"><Icon Name="star" /> Dein Premium-Zugang</h2>
            @foreach (var s in _active)
            {
                <div class="row" style="justify-content:space-between;gap:10px;flex-wrap:wrap">
                    <p style="margin:0">
                        @(string.IsNullOrEmpty(s.PlanTitle) ? "Premium" : s.PlanTitle): <strong>@EndLabel(s)</strong>
                        @if (_status.TryGetValue(s.SubscriptionId, out var st) && st.Ok)
                        {
                            <br />
                            <span class="small muted">
                                @if (st.IsActive) { @($"Nächste Abbuchung am {st.NextRebill:dd.MM.yyyy}{(st.AmountText.Length > 0 ? $" ({st.AmountText})" : "")}{(st.RebillPeriodDays > 0 ? $", danach alle {st.RebillPeriodDays} Tage" : "")} – bis du kündigst.") }
                                else if (st.IsCanceled) { @($"Gekündigt – wird nicht mehr verlängert. Dein Zugang bleibt bis {st.NextRebill:dd.MM.yyyy}.") }
                                else if (st.IsEnded) { @("Das Abo ist beendet.") }
                            </span>
                        }
                        else if (s.Cancelled > 0) { <br /><span class="small muted">Gekündigt am @ForumTime.Date(s.Cancelled) – wird nicht mehr verlängert. Dein Zugang bleibt bis zum Ende der bezahlten Zeit.</span> }
                        else if (s.CanCancel(_now)) { <br /><span class="small muted">Verlängert sich automatisch, bis du kündigst.</span> }
                    </p>
                    @if (s.CanCancel(_now) && !(_status.TryGetValue(s.SubscriptionId, out var st2) && st2.Ok && !st2.IsActive))
                    {
                        <form method="post" action="/premium/cancel/@s.SubscriptionId" class="inline" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm" data-confirm="Abo wirklich kündigen? Es wird dann nicht mehr verlängert.">Abo kündigen</button>
                        </form>
                    }
                </div>
            }
            @if (_forum != null) { <p style="margin:0"><a class="btn btn-primary" href="@Links.Forum(_forum)">Weiter zu „@_forum.DisplayTitle“</a></p> }
        </section>
    }

    <PremiumOffer User="_user!" Title="@(_active.Count > 0 ? "Verlängern oder upgraden" : "Wähle deinen Zugang")" ReturnUrl="@ReturnUrl" />
</main>

@code {
    [SupplyParameterFromQuery(Name = "forum")] public int? ForumId { get; set; }
    [SupplyParameterFromQuery(Name = "done")] public string? Done { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "cancel")] public string? CancelQ { get; set; }
    private long _now = ForumTime.Now;
    private string? _cancelMsg => CancelQ switch
    {
        "ok" => "Dein Abo wurde gekündigt und wird nicht mehr verlängert.",
        "already" => "Dein Abo war bereits gekündigt bzw. beendet.",
        "nomembership" => "Zu dieser Buchung gibt es kein laufendes Abo – sie verlängert sich nicht automatisch.",
        "notfound" => "Das Abo wurde beim Zahlungsdienst nicht gefunden. Bitte wende dich an das Team.",
        "notpossible" => "Dieses Abo kann hier nicht gekündigt werden.",
        "failed" => "Die Kündigung hat nicht geklappt. Bitte versuche es später erneut oder wende dich an das Team.",
        _ => null,
    };

    private bool _loaded;
    private BoardSnapshot? _snap;
    private ForumUser? _user;
    private Forum? _forum;
    private List<PremiumService.Subscription> _active = new();
    private readonly Dictionary<long, RstPayService.MembershipStatus> _status = new();

    /// <summary>Kurzinfo zur Laufzeit – bei rstpay-Abos mit dem Live-Status (nächste Abbuchung bzw. Zugang bis).</summary>
    private string EndLabel(PremiumService.Subscription s)
    {
        if (_status.TryGetValue(s.SubscriptionId, out var st) && st.Ok && st.NextRebill is DateTime d)
            return st.IsActive ? "aktiv" : st.IsCanceled ? $"gültig bis {d:dd.MM.yyyy}" : "beendet";
        return s.EndDate > 0 ? $"gültig bis {ForumTime.Date(s.EndDate)}" : s.IsLifetime ? "lebenslang" : s.PaidUntil > 0 ? $"bezahlt bis {ForumTime.Date(s.PaidUntil)}" : "aktiv";
    }

    private string ReturnUrl => "/premium" + (_forum != null ? $"?forum={_forum.ForumId}" : "");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snap = await Cache.GetAsync();
            _user = await Current.GetAsync();
            if (_user.IsGuest)
            {
                // Abschließen nur mit Benutzerkonto
                Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);
                return;
            }
            if (ForumId is int f) _forum = _snap.Forum(f);
            if (!_user.IsGuest)
            {
                var now = ForumTime.Now;
                _active = (await Premium.UserSubscriptionsAsync(_user.UserId)).Where(s => s.IsActive(now)).ToList();
                // Live-Status bei rstpay (nächste Abbuchung, gekündigt …) für wiederkehrende Abos
                foreach (var s in _active.Where(s => s.Source == "rstpay" && s.PlanMonths != 0))
                {
                    var st = await RstPay.MembershipStatusAsync(s, fresh: CancelQ != null);
                    _status[s.SubscriptionId] = st;
                    if (st.Ok && !st.IsActive && s.Cancelled == 0) s.Cancelled = ForumTime.Now;
                }
            }
        }
        finally { _loaded = true; }
    }
}
