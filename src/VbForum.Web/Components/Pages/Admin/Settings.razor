@page "/admin/settings"
@attribute [Authorize(Policy = "Admin")]
@rendermode InteractiveServer
@inject ReputationService RepService
@inject BoardCache Cache
@inject MailService Mail
@inject CurrentUser Current
@inject TokenRepository Audit
@inject ForumPaths Paths
@inject AssetStore AssetDb

<PageTitle>Einstellungen – Administration</PageTitle>

<main class="page container">
    <AdminShell Active="settings" Title="Einstellungen" Subtitle="Allgemeine Board-Einstellungen">
        @if (_s == null) { <div class="card empty">Lade …</div> }
        else
        {
            @if (_msg != null) { <div class="alert alert-ok" role="status">@_msg</div> }
            @if (_err != null) { <div class="alert alert-err" role="alert">@_err</div> }

            <section class="card card-pad stack">
                <h2 class="card-title">Allgemein</h2>
                <div class="form-grid">
                    <div class="field"><label for="st-name">Forenname</label><input id="st-name" @bind="_s.BoardName" /></div>
                    <div class="field"><label for="st-url">Basis-URL</label><input id="st-url" @bind="_s.BaseUrl" placeholder="https://forum.example.de" /><span class="hint">Für Links in E-Mails.</span></div>
                    <div class="field"><label for="st-tz">Zeitzone</label><input id="st-tz" @bind="_s.TimeZone" /><span class="hint">z. B. Europe/Berlin</span></div>
                </div>
                <div class="field"><label for="st-desc">Beschreibung / Willkommenstext</label><input id="st-desc" @bind="_s.BoardDescription" /></div>

                <div class="stack" style="gap:8px">
                    <span class="label" style="font-size:13px;font-weight:600">Logo</span>
                    <div class="row" style="gap:16px">
                        @if (!string.IsNullOrEmpty(_s.LogoFile))
                        {
                            <img src="/branding/logo?v=@_logoVersion" alt="Aktuelles Logo" style="max-height:48px;border:1px solid var(--border);border-radius:8px;padding:4px;background:var(--card)" />
                            <button type="button" class="btn btn-ghost" @onclick="RemoveLogo">Logo entfernen</button>
                        }
                        else { <span class="muted small">Kein Logo – es wird der Forenname angezeigt.</span> }
                        <label class="file-drop"><Icon Name="image" />Logo hochladen<InputFile OnChange="UploadLogo" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label>
                    </div>
                    <span class="hint">PNG, JPG, WebP oder SVG. Wird im Kopf mit max. 40 px Höhe angezeigt (ideal: 80 px hoch für scharfe Darstellung).</span>
                </div>

                <div class="stack" style="gap:8px">
                    <span class="label" style="font-size:13px;font-weight:600">Favicon</span>
                    <div class="row" style="gap:16px">
                        <img src="@(string.IsNullOrEmpty(_s.FaviconFile) ? "/favicon.svg" : $"/branding/favicon?v={Uri.EscapeDataString(_s.FaviconFile)}")" alt="Aktuelles Favicon" width="32" height="32" style="border:1px solid var(--border);border-radius:6px;padding:3px;background:var(--card)" />
                        @if (!string.IsNullOrEmpty(_s.FaviconFile)) { <button type="button" class="btn btn-ghost" @onclick="RemoveFavicon">Standard wiederherstellen</button> }
                        else { <span class="muted small">Standard-Favicon</span> }
                        <label class="file-drop"><Icon Name="image" />Favicon hochladen<InputFile OnChange="UploadFavicon" accept="image/png,image/svg+xml,image/x-icon,image/vnd.microsoft.icon,.ico" /></label>
                    </div>
                    <span class="hint">PNG (quadratisch, z. B. 64 × 64 oder größer – wird auf 192 px verkleinert), SVG oder ICO. Logo und Favicon werden in der Datenbank gespeichert und bleiben bei einem Redeploy erhalten.</span>
                </div>

                <label class="toggle-row" style="border-top:1px solid var(--border-soft)">Forum im Wartungsmodus (nur Admins haben Zugang)<input type="checkbox" @bind="_s.BoardOffline" /></label>
                @if (_s.BoardOffline)
                {
                    <div class="field"><label for="st-off">Wartungstext</label><textarea id="st-off" @bind="_s.OfflineMessage" rows="3"></textarea></div>
                }
            </section>

            <section class="card card-pad stack">
                <h2 class="card-title">Anzeige &amp; Beiträge</h2>
                <div class="form-grid">
                    <div class="field"><label for="st-tpp">Themen pro Seite</label><input id="st-tpp" type="number" min="5" max="100" @bind="_s.ThreadsPerPage" /></div>
                    <div class="field"><label for="st-ppp">Beiträge pro Seite</label><input id="st-ppp" type="number" min="5" max="100" @bind="_s.PostsPerPage" /></div>
                    <div class="field"><label for="st-ud">„Ungelesen“-Zeitraum (Tage)</label><input id="st-ud" type="number" min="1" max="365" @bind="_s.UnreadDays" /></div>
                    <div class="field"><label for="st-flood">Mindestabstand zwischen Beiträgen (Sek.)</label><input id="st-flood" type="number" min="0" max="600" @bind="_s.MinSecondsBetweenPosts" /></div>
                </div>
                <label class="toggle-row">Externe http-Bilder über den eigenen Server laden (Bild-Proxy, vermeidet „unsicher“-Warnungen)<input type="checkbox" @bind="_s.ImageProxy" /></label>
            </section>

            <section class="card card-pad stack">
                <h2 class="card-title">Anhänge &amp; Avatare</h2>
                <div class="form-grid">
                    <div class="field"><label for="st-ext">Erlaubte Dateiendungen</label><input id="st-ext" @bind="_s.AttachmentExtensions" /></div>
                    <div class="field"><label for="st-max">Max. Größe pro Datei (KB)</label><input id="st-max" type="number" min="100" @bind="_s.MaxAttachmentKb" /></div>
                    <div class="field"><label for="st-maxn">Max. Anhänge pro Beitrag</label><input id="st-maxn" type="number" min="1" max="50" @bind="_s.MaxAttachmentsPerPost" /></div>
                    <div class="field"><label for="st-thumb">Vorschaubild-Größe (px)</label><input id="st-thumb" type="number" min="100" max="1200" @bind="_s.ThumbnailSize" /></div>
                </div>
            </section>

            <section class="card card-pad stack">
                <h2 class="card-title">Registrierung &amp; Gruppen</h2>
                <label class="toggle-row">Neue Registrierungen erlauben<input type="checkbox" @bind="_s.AllowRegistration" /></label>
                <label class="toggle-row">E-Mail-Bestätigung verlangen (nur wenn SMTP eingerichtet ist)<input type="checkbox" @bind="_s.RequireEmailConfirmation" /></label>
                <label class="toggle-row">Passwörter zusätzlich im vB-Format speichern (altes Board bleibt nutzbar)<input type="checkbox" @bind="_s.SyncLegacyPassword" /></label>
                <div class="form-grid" style="margin-top:8px">
                    <GroupSelect Label="Gruppe für neue Mitglieder" @bind-Value="_s.RegisteredGroupId" Groups="_groups" />
                    <GroupSelect Label="Gruppe „E-Mail unbestätigt“" @bind-Value="_s.AwaitingEmailGroupId" Groups="_groups" />
                    <GroupSelect Label="Gästegruppe" @bind-Value="_s.GuestGroupId" Groups="_groups" />
                    <div class="field"><label for="st-ag">Administrator-Gruppen (IDs)</label><input id="st-ag" @bind="_s.AdminGroupIds" /><span class="hint">Kommagetrennt, z. B. 6</span></div>
                    <div class="field"><label for="st-sm">Super-Moderator-Gruppen</label><input id="st-sm" @bind="_s.SuperModGroupIds" /></div>
                    <div class="field"><label for="st-bg">Gesperrt-Gruppen</label><input id="st-bg" @bind="_s.BannedGroupIds" /></div>
                </div>
            </section>

            <section class="card card-pad stack">
                <h2 class="card-title">E-Mail-Versand (SMTP)</h2>
                <div class="form-grid">
                    <div class="field"><label for="st-host">SMTP-Server</label><input id="st-host" @bind="_s.SmtpHost" /></div>
                    <div class="field"><label for="st-port">Port</label><input id="st-port" type="number" @bind="_s.SmtpPort" /></div>
                    <div class="field"><label for="st-su">Benutzer</label><input id="st-su" @bind="_s.SmtpUser" autocomplete="off" /></div>
                    <div class="field"><label for="st-sp">Passwort</label><input id="st-sp" type="password" @bind="_s.SmtpPassword" autocomplete="new-password" /></div>
                </div>
                <div class="form-grid">
                    <div class="field"><label for="st-fromname">Absendername</label><input id="st-fromname" @bind="_s.MailFromName" placeholder="@_s.BoardName" /><span class="hint">Leer = Name des Forums.</span></div>
                    <div class="field"><label for="st-from">Absenderadresse</label><input id="st-from" type="email" @bind="_s.MailFrom" placeholder="forum@example.com" /></div>
                    <div class="field"><label for="st-reply">Antwortadresse (optional)</label><input id="st-reply" type="email" @bind="_s.MailReplyTo" /><span class="hint">Wohin Antworten auf Forum-Mails gehen.</span></div>
                </div>
                <div class="field">
                    <label for="st-sec">Verschlüsselung</label>
                    <select id="st-sec" @bind="_s.SmtpSecurity">
                        <option value="auto">Automatisch (Port 465 = SSL/TLS, sonst STARTTLS)</option>
                        <option value="ssl">SSL/TLS direkt beim Verbinden (meist Port 465)</option>
                        <option value="starttls">STARTTLS (meist Port 587 oder 25)</option>
                        <option value="none">Keine (nur im internen Netz)</option>
                    </select>
                </div>
                <div class="row">
                    <input class="input" style="flex:1 1 240px" type="email" placeholder="Test-Empfänger" @bind="_testTo" aria-label="Test-Empfänger" />
                    <button type="button" class="btn" @onclick="TestMail" disabled="@_busy">Testmail senden</button>
                </div>
                <span class="hint">Vor dem Test bitte speichern. <a href="/admin/mail-preview" target="_blank" rel="noopener">Vorschau der Mails ansehen</a> – mit Logo und Forenname aus diesen Einstellungen.</span>
            </section>

            <section class="card card-pad stack">
                <h2 class="card-title">Umfragen &amp; Reputation</h2>
                <label class="toggle-row">Neue Umfragen erlauben (bestehende Umfragen bleiben immer sichtbar)<input type="checkbox" @bind="_s.PollsEnabled" /></label>
                <label class="toggle-row">Reputation anzeigen und vergeben<input type="checkbox" @bind="_s.ReputationEnabled" /></label>
                <label class="toggle-row">Negative Bewertungen erlauben<input type="checkbox" @bind="_s.ReputationAllowNegative" /></label>
                <label class="toggle-row">Empfänger sehen, wer sie bewertet hat (sonst anonym, wie in vBulletin)<input type="checkbox" @bind="_s.ReputationShowNames" /></label>
                <div class="form-grid">
                    <div class="field"><label for="rp-mp">Mindestanzahl Beiträge zum Bewerten</label><input id="rp-mp" type="number" min="0" @bind="_s.ReputationMinPosts" /></div>
                    <div class="field"><label for="rp-mr">Mindest-Reputation zum Bewerten</label><input id="rp-mr" type="number" @bind="_s.ReputationMinReputation" /></div>
                    <div class="field"><label for="rp-dl">Bewertungen pro 24 Stunden</label><input id="rp-dl" type="number" min="0" @bind="_s.ReputationDailyLimit" /><span class="hint">0 = unbegrenzt</span></div>
                    <div class="field"><label for="rp-sp">Erst X andere bewerten, bevor derselbe wieder geht</label><input id="rp-sp" type="number" min="0" @bind="_s.ReputationSpread" /></div>
                    <div class="field"><label for="rp-pp">+1 Stärke je … Beiträge</label><input id="rp-pp" type="number" min="0" @bind="_s.ReputationPostsPerPoint" /><span class="hint">0 = aus</span></div>
                    <div class="field"><label for="rp-rp">+1 Stärke je … Reputationspunkte</label><input id="rp-rp" type="number" min="0" @bind="_s.ReputationRepPerPoint" /><span class="hint">0 = aus</span></div>
                    <div class="field"><label for="rp-dp">+1 Stärke je … Tage Mitgliedschaft</label><input id="rp-dp" type="number" min="0" @bind="_s.ReputationDaysPerPoint" /><span class="hint">0 = aus</span></div>
                    <div class="field"><label for="rp-ap">Feste Stärke für Administratoren</label><input id="rp-ap" type="number" min="0" @bind="_s.ReputationAdminPower" /><span class="hint">0 = normal berechnen</span></div>
                </div>
                <p class="small muted" style="margin:0">Berechnung wie in vBulletin: Stärke = 1 + Beiträge/… + Reputation/… + Tage/…; negative Bewertungen zählen halb. Die Texte der Stufen kommen aus der alten vBulletin-Datenbank.</p>
                <div><button type="button" class="btn btn-sm" @onclick="ImportRep">Werte aus der alten vBulletin-Konfiguration übernehmen</button></div>
            </section>

            <div class="form-actions" style="position:sticky;bottom:12px">
                <button type="button" class="btn" @onclick="Reload">Verwerfen</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@_busy">Einstellungen speichern</button>
            </div>
        }
    </AdminShell>
</main>

@code {
    private BoardSettings? _s;
    private List<UserGroup> _groups = new();
    private string? _msg, _err, _testTo;
    private bool _busy;
    private string _logoVersion = "";

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var snap = await Cache.GetAsync();
        _s = snap.Settings.Clone();
        _groups = snap.Groups.Values.OrderBy(g => g.UserGroupId).ToList();
        _logoVersion = _s.LogoFile;
        _msg = _err = null;
    }

    private async Task Save()
    {
        _busy = true; _msg = _err = null;
        try
        {
            _s!.ThreadsPerPage = Math.Clamp(_s.ThreadsPerPage, 5, 100);
            _s.PostsPerPage = Math.Clamp(_s.PostsPerPage, 5, 100);
            try { TimeZoneInfo.FindSystemTimeZoneById(_s.TimeZone); } catch { _err = $"Unbekannte Zeitzone „{_s.TimeZone}“."; return; }
            await Cache.SaveSettingsAsync(_s);
            await Audit.LogAsync(await Current.GetAsync(), "settings.save", "", "");
            _msg = "Einstellungen gespeichert.";
        }
        catch (Exception ex) { _err = "Speichern fehlgeschlagen: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ImportRep()
    {
        _msg = _err = null;
        var n = await RepService.ImportLegacySettingsAsync(_s!);
        if (n == 0) _err = "In der Datenbank wurden keine vBulletin-Einstellungen zur Reputation gefunden.";
        else _msg = $"{n} Werte aus vBulletin übernommen – bitte noch speichern.";
    }

    /// <summary>Hochgeladenes Bild prüfen. SVG nur ohne Skripte.</summary>
    private async Task<(byte[] Data, string Ext)?> ReadImageAsync(IBrowserFile f, long max, bool allowIco)
    {
        if (f.Size > max) { _err = $"Die Datei darf höchstens {max / 1024} KB groß sein."; return null; }
        using var ms = new MemoryStream();
        await f.OpenReadStream(max).CopyToAsync(ms);
        var data = ms.ToArray();
        if (f.Name.EndsWith(".svg", StringComparison.OrdinalIgnoreCase))
        {
            var text = System.Text.Encoding.UTF8.GetString(data);
            if (!text.Contains("<svg") || text.Contains("<script", StringComparison.OrdinalIgnoreCase) ||
                System.Text.RegularExpressions.Regex.IsMatch(text, @"\son\w+\s*=", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            { _err = "Die SVG-Datei enthält Skripte und wird aus Sicherheitsgründen nicht akzeptiert."; return null; }
            return (data, "svg");
        }
        if (allowIco && data.Length > 4 && data[0] == 0 && data[1] == 0 && data[2] == 1 && data[3] == 0) return (data, "ico");
        var info = ImageService.Inspect(data);
        if (info == null) { _err = "Die Datei ist kein unterstütztes Bild."; return null; }
        return (data, info.Extension);
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        _msg = _err = null;
        if (await ReadImageAsync(e.File, 2 * 1024 * 1024, false) is not { } img) return;
        await AssetDb.SetAsync("logo", ImageService.ContentType(img.Ext), img.Data);
        var name = $"logo-{DateTime.UtcNow.Ticks}.{img.Ext}";
        _s!.LogoFile = name;
        var current = (await Cache.GetAsync()).Settings.Clone();
        current.LogoFile = name;
        await Cache.SaveSettingsAsync(current);
        _logoVersion = name;
        _msg = "Logo gespeichert.";
    }

    private async Task RemoveLogo()
    {
        await AssetDb.RemoveAsync("logo");
        var current = (await Cache.GetAsync()).Settings.Clone();
        current.LogoFile = "";
        await Cache.SaveSettingsAsync(current);
        _s!.LogoFile = "";
        _msg = "Logo entfernt.";
    }

    private async Task UploadFavicon(InputFileChangeEventArgs e)
    {
        _msg = _err = null;
        if (await ReadImageAsync(e.File, 1024 * 1024, true) is not { } img) return;
        var (data, ext) = img;
        if (ext is not ("svg" or "ico"))
        {
            // Rasterbilder: quadratisch auf max. 192 px als PNG
            var info = ImageService.Inspect(data);
            if ((ext != "png" || info is { Width: > 192 } or { Height: > 192 }) && ImageService.Resize(data, 192, square: true, forcePng: true) is { } r)
            { data = r.Data; ext = r.Extension; }
        }
        var type = ext == "ico" ? "image/x-icon" : ImageService.ContentType(ext);
        await AssetDb.SetAsync("favicon", type, data);
        var name = $"favicon-{DateTime.UtcNow.Ticks}.{ext}";
        _s!.FaviconFile = name;
        var current = (await Cache.GetAsync()).Settings.Clone();
        current.FaviconFile = name;
        await Cache.SaveSettingsAsync(current);
        _msg = "Favicon gespeichert. Browser zeigen es teilweise erst nach einem Neuladen der Seite an.";
    }

    private async Task RemoveFavicon()
    {
        await AssetDb.RemoveAsync("favicon");
        var current = (await Cache.GetAsync()).Settings.Clone();
        current.FaviconFile = "";
        await Cache.SaveSettingsAsync(current);
        _s!.FaviconFile = "";
        _msg = "Standard-Favicon wiederhergestellt.";
    }

    private async Task TestMail()
    {
        _busy = true; _msg = _err = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_testTo)) { _err = "Bitte einen Empfänger angeben."; return; }
            var error = await Mail.TrySendAsync(_testTo, "Testmail", new MailContent("Hallo,",
                new[] { "wenn du diese Nachricht liest, funktioniert der E-Mail-Versand des Forums." },
                "Zum Forum", await Mail.AbsoluteUrlAsync("/")));
            if (error == null) _msg = "Testmail wurde verschickt."; else _err = "Versand fehlgeschlagen: " + error;
        }
        finally { _busy = false; }
    }
}
