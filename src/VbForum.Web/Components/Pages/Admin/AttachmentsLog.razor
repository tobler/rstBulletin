@page "/admin/attachments"
@page "/admin/log"
@attribute [Authorize(Policy = "Admin")]
@rendermode InteractiveServer
@inject AttachmentRepository Attachments
@inject TokenRepository Audit
@inject CurrentUser Current
@inject NavigationManager Nav

<PageTitle>@(_log ? "Protokoll" : "Anhänge") – Administration</PageTitle>

<main class="page container">
    @if (_log)
    {
        <AdminShell Active="log" Title="Protokoll" Subtitle="Aktionen von Administratoren und Moderatoren in diesem Forum">
            <section class="card">
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>Zeit</th><th>Benutzer</th><th>Aktion</th><th>Ziel</th><th class="hide-mobile">IP</th></tr></thead>
                        <tbody>
                            @foreach (var a in _audit)
                            {
                                <tr><td class="small nowrap">@ForumTime.Full(a.Dateline)</td><td>@a.Username</td><td><code>@a.Action</code></td><td class="small">@a.Target</td><td class="small hide-mobile">@a.Ip</td></tr>
                            }
                            @if (_audit.Count == 0) { <tr><td colspan="5" class="muted">Noch keine Einträge.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </section>
        </AdminShell>
    }
    else
    {
        <AdminShell Active="att" Title="Anhänge" Subtitle="@(_stats == null ? "Dateien in der Datenbank" : $"{ForumTime.Number(_stats.Count)} Dateien · {HtmlUtil.FormatBytes(_stats.Bytes)} in der Datenbank")">
            @if (_msg != null) { <div class="alert alert-ok" role="status">@_msg</div> }
            <section class="card">
                <div class="toolbar">
                    <input class="input" style="flex:1 1 240px" placeholder="Dateiname oder Benutzer suchen" @bind="_q.Search" @bind:event="oninput" @onkeyup="SearchKey" aria-label="Anhänge durchsuchen" />
                    <select class="input" style="flex:0 0 auto" @bind="_q.Kind" @bind:after="() => LoadAsync(1)" aria-label="Art">
                        <option value="">Alle Dateien</option>
                        <option value="images">Nur Bilder</option>
                        <option value="files">Nur andere Dateien</option>
                    </select>
                    <select class="input" style="flex:0 0 auto" @bind="_q.Sort" @bind:after="() => LoadAsync(1)" aria-label="Sortierung">
                        <option value="new">Neueste zuerst</option>
                        <option value="old">Älteste zuerst</option>
                        <option value="size">Größte zuerst</option>
                        <option value="name">Dateiname A–Z</option>
                    </select>
                    <button type="button" class="btn" @onclick="() => LoadAsync(1)">Suchen</button>
                </div>
                @if (_rows == null)
                {
                    <div class="empty">Lade Anhänge …</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th style="width:64px"></th><th>Datei</th><th class="num">Größe</th><th class="hide-mobile">Thema</th><th class="hide-mobile">Von</th><th class="hide-mobile">Datum</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var r in _rows.Items)
                                {
                                    var a = r.A;
                                    <tr>
                                        <td>
                                            @if (a.IsImage)
                                            {
                                                <a href="/attachment/@a.AttachmentId" target="_blank"><img src="/attachment/@a.AttachmentId/thumb" alt="" loading="lazy" style="width:56px;height:42px;object-fit:cover;border-radius:6px;border:1px solid var(--border);display:block" /></a>
                                            }
                                            else { <span class="muted"><Icon Name="paperclip" /></span> }
                                        </td>
                                        <td><a href="/attachment/@a.AttachmentId" target="_blank">@a.DisplayName</a>@if (a.Width > 0) { <div class="small muted">@a.Width × @a.Height</div> }</td>
                                        <td class="num nowrap">@HtmlUtil.FormatBytes(a.FileSize)</td>
                                        <td class="hide-mobile small">@if (r.ThreadId > 0) { <a href="/post/@a.ContentId" target="_blank">@HtmlUtil.CleanTitle(r.ThreadTitle)</a> } else { <span class="muted">– Beitrag gelöscht –</span> }</td>
                                        <td class="hide-mobile small">@if (a.UserId > 0) { <a href="/admin/users/@a.UserId">@HtmlUtil.CleanTitle(r.Username)</a> } else { @HtmlUtil.CleanTitle(r.Username) }</td>
                                        <td class="hide-mobile small nowrap">@ForumTime.Date(a.Dateline)</td>
                                        <td><button type="button" class="btn btn-sm btn-ghost btn-danger" title="Anhang löschen" @onclick="() => _confirm = a"><Icon Name="trash" Size="16" /></button></td>
                                    </tr>
                                }
                                @if (_rows.Items.Count == 0) { <tr><td colspan="7" class="empty">Keine Anhänge gefunden.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                    <div class="list-foot">
                        <span>@(_rows.Total == 0 ? "" : $"{(_rows.Page - 1) * _rows.PageSize + 1}–{Math.Min(_rows.Page * _rows.PageSize, _rows.Total)} von {ForumTime.Number(_rows.Total)}")</span>
                        @if (_rows.PageCount > 1)
                        {
                            <div class="row" style="gap:6px">
                                <button type="button" class="btn btn-sm" disabled="@(_rows.Page <= 1)" @onclick="() => LoadAsync(1)">«</button>
                                <button type="button" class="btn btn-sm" disabled="@(_rows.Page <= 1)" @onclick="() => LoadAsync(_rows.Page - 1)">‹ Zurück</button>
                                <span class="small">Seite @_rows.Page von @ForumTime.Number(_rows.PageCount)</span>
                                <button type="button" class="btn btn-sm" disabled="@(_rows.Page >= _rows.PageCount)" @onclick="() => LoadAsync(_rows.Page + 1)">Weiter ›</button>
                                <button type="button" class="btn btn-sm" disabled="@(_rows.Page >= _rows.PageCount)" @onclick="() => LoadAsync(_rows.PageCount)">»</button>
                            </div>
                        }
                    </div>
                }
            </section>
        </AdminShell>
    }
</main>

@if (_confirm != null)
{
    <div class="modal-back" @onclick="() => _confirm = null">
        <div class="modal" role="alertdialog" aria-modal="true" @onclick:stopPropagation>
            <h2 class="card-title">„@_confirm.DisplayName“ löschen?</h2>
            <p class="muted" style="margin:0">Die Datei verschwindet aus dem Beitrag. Das kann nicht rückgängig gemacht werden.</p>
            <div class="form-actions">
                <button type="button" class="btn" @onclick="() => _confirm = null">Abbrechen</button>
                <button type="button" class="btn btn-danger" @onclick="Delete">Löschen</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _log;
    private List<TokenRepository.AuditEntry> _audit = new();
    private AttachmentRepository.Stats? _stats;
    private PagedResult<AttachmentRepository.AdminRow>? _rows;
    private readonly AttachmentRepository.AdminQuery _q = new() { Sort = "new", Kind = "" };
    private Attachment? _confirm;
    private string? _msg;

    protected override void OnInitialized() => _log = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin/log");

    // Erst laden, wenn die Seite interaktiv ist – so erscheint sie sofort (kein doppeltes Laden beim Vorab-Rendern)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        if (_log) { _audit = await Audit.AuditAsync(300); StateHasChanged(); return; }
        await LoadAsync(1);
        StateHasChanged();
        _stats = await Attachments.StatsAsync();
        StateHasChanged();
    }

    private async Task SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _q.Page = Math.Max(1, page);
        _rows = await Attachments.AdminSearchAsync(_q);
    }

    private async Task Delete()
    {
        var a = _confirm!;
        _confirm = null;
        await Attachments.DeleteAsync(a.AttachmentId);
        await Audit.LogAsync(await Current.GetAsync(), "attachment.delete", $"{a.AttachmentId} {a.DisplayName}", "");
        _msg = $"„{a.DisplayName}“ gelöscht.";
        await LoadAsync(_q.Page);
        _stats = await Attachments.StatsAsync(refresh: true);
    }
}
