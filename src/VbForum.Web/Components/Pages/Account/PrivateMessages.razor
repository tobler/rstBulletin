@page "/account/pm"
@page "/account/pm/{PmId:long}"
@page "/account/pm/new"
@attribute [Authorize]
@inject CurrentUser Current
@inject BoardCache Cache
@inject PmRepository Pms
@inject UserRepository Users
@inject PostRenderer Renderer
@inject MailService Mail
@inject NavigationManager Nav

<PageTitle>Private Nachrichten</PageTitle>

@if (!_loaded) { return; }
<main class="page container">
    <AccountShell User="_user!" Active="pm">
        @if (_message != null) { <div class="alert alert-ok" role="status">@_message</div> }
        @if (_error != null) { <div class="alert alert-err" role="alert">@_error</div> }

        @if (_isNew)
        {
            <EditForm Model="Compose" FormName="pm" OnSubmit="SendAsync" class="card card-pad stack" Enhance>
                <h2 class="card-title">Neue Nachricht</h2>
                <div class="field">
                    <label for="pm-to">Empfänger</label>
                    <InputText id="pm-to" @bind-Value="Compose!.To" placeholder="Benutzername (mehrere mit ; trennen)" />
                </div>
                <div class="field">
                    <label for="pm-title">Betreff</label>
                    <InputText id="pm-title" @bind-Value="Compose.Title" maxlength="85" />
                </div>
                <div class="field">
                    <label for="pm-text">Nachricht</label>
                    <InputTextArea id="pm-text" @bind-Value="Compose.Message" rows="10" />
                    <span class="hint">BBCode wird unterstützt.</span>
                </div>
                <input type="hidden" name="Compose.ParentPmId" value="@Compose.ParentPmId" />
                <div class="form-actions"><a class="btn" href="/account/pm">Abbrechen</a><button type="submit" class="btn btn-primary"><Icon Name="send" />Senden</button></div>
            </EditForm>
        }
        else if (_pm != null)
        {
            <section class="card card-pad stack">
                <div class="row" style="justify-content:space-between">
                    <h2 class="card-title" style="margin:0">@_pm.DisplayTitle</h2>
                    <a class="btn btn-sm" href="/account/pm@(_pm.FolderId == PmRepository.Sent ? "?folder=sent" : "")">← Zurück</a>
                </div>
                @if (_conversation.Count > 1)
                {
                    <p class="small muted" style="margin:0">Gesprächsverlauf · @_conversation.Count Nachrichten, die neueste unten</p>
                }
            </section>
            @foreach (var m in _conversation)
            {
                var mine = m.FromUserId == _user!.UserId;
                var current = m.PmTextId == _pm.PmTextId;
                <article id="pm@(m.PmId)" class="card card-pad stack pm-msg @(mine ? "pm-mine" : "") @(current ? "pm-current" : "")">
                    <div class="row small muted">
                        <Avatar UserId="m.FromUserId" Name="@HtmlUtil.CleanTitle(m.FromUsername)" Size="32" />
                        <span>
                            @if (mine) { <strong style="color:var(--ink)">Du</strong> }
                            else { <strong style="color:var(--ink)"><UserName UserId="m.FromUserId" Name="@HtmlUtil.CleanTitle(m.FromUsername)" IsAdmin="_user.IsAdmin" /></strong> }
                            an @string.Join(", ", PmRepository.Recipients(m.ToUserArray)) · @ForumTime.Full(m.Dateline)
                            @if (m.MessageRead == 2 && !mine) { <span class="pill" style="margin-left:6px">beantwortet</span> }
                        </span>
                    </div>
                    <div class="post-body">@_bodies[m.PmTextId]</div>
                    @if (current)
                    {
                        <div class="post-actions">
                            <form method="post" @formname="pmdelete" @onsubmit="DeleteAsync" class="inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-sm btn-danger" data-confirm="Nachricht löschen?">Löschen</button>
                            </form>
                        </div>
                    }
                </article>
            }
            @if (_replyTo != null)
            {
                <div class="form-actions"><a class="btn btn-primary" href="/account/pm/new?reply=@_replyTo.PmId"><Icon Name="reply" />Antworten</a></div>
            }
        }
        else
        {
            <section class="card">
                <div class="card-head" style="flex-wrap:wrap">
                    <div class="seg" role="group" aria-label="Ordner">
                        <a href="/account/pm" class="@(!_sent ? "on" : "")">Posteingang</a>
                        <a href="/account/pm?folder=sent" class="@(_sent ? "on" : "")">Gesendet</a>
                    </div>
                    <a class="btn btn-primary btn-sm" href="/account/pm/new"><Icon Name="plus" />Neue Nachricht</a>
                </div>
                @foreach (var m in _list!.Items)
                {
                    <a href="/account/pm/@m.PmId" class="thread-row" style="text-decoration:none;color:inherit;@(m.IsUnread && !_sent ? "background:var(--unread-bg)" : "")">
                        <div class="thread-main" style="align-items:center">
                            <Avatar UserId="m.FromUserId" Name="@HtmlUtil.CleanTitle(m.FromUsername)" Size="36" />
                            <div class="stack" style="gap:2px;min-width:0">
                                <span class="thread-title @(m.IsUnread && !_sent ? "unread" : "")">@m.DisplayTitle</span>
                                <span class="thread-sub">@(_sent ? "an " + string.Join(", ", PmRepository.Recipients(m.ToUserArray)) : HtmlUtil.CleanTitle(m.FromUsername)) · @ForumTime.Relative(m.Dateline)@(m.IsUnread && !_sent ? " · ungelesen" : "")</span>
                            </div>
                        </div>
                    </a>
                }
                @if (_list.Items.Count == 0) { <div class="empty">Keine Nachrichten.</div> }
                <div class="list-foot">
                    <span>@ForumTime.Number(_list.Total) Nachrichten</span>
                    <Pager Page="_list.Page" PageCount="_list.PageCount" Href='p => Links.WithQuery("/account/pm", new Dictionary<string, object?> { ["folder"] = _sent ? "sent" : null, ["page"] = p > 1 ? p : null })' />
                </div>
            </section>
        }
    </AccountShell>
</main>

@code {
    public sealed class ComposeInput
    {
        public string To { get; set; } = "";
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public long ParentPmId { get; set; }
    }

    [Parameter] public long PmId { get; set; }
    [SupplyParameterFromQuery] public string? Folder { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageQ { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToQ { get; set; }
    [SupplyParameterFromQuery(Name = "reply")] public long? ReplyQ { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }
    [SupplyParameterFromForm(FormName = "pm")] public ComposeInput? Compose { get; set; }

    private bool _loaded, _isNew, _sent;
    private ForumUser? _user;
    private PagedResult<PrivateMessage>? _list;
    private PrivateMessage? _pm, _replyTo;
    private List<PrivateMessage> _conversation = new();
    private readonly Dictionary<long, MarkupString> _bodies = new();
    private string? _message, _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _user = await Current.GetAsync();
            _isNew = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("account/pm/new");
            _sent = Folder == "sent";
            if (Msg == "sent") _message = "Nachricht gesendet.";
            if (Msg == "deleted") _message = "Nachricht gelöscht.";
            if (_isNew)
            {
                if (Compose == null)
                {
                    Compose = new ComposeInput { To = ToQ ?? "" };
                    if (ReplyQ is long r && await Pms.GetAsync(_user.UserId, r) is { } orig)
                    {
                        Compose.To = HtmlUtil.CleanTitle(orig.FromUsername);
                        Compose.Title = orig.DisplayTitle.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? orig.DisplayTitle : "Re: " + orig.DisplayTitle;
                        Compose.Message = $"[quote={HtmlUtil.CleanTitle(orig.FromUsername)}]{HtmlUtil.DecodeNumericEntities(orig.Message)}[/quote]\n";
                        Compose.ParentPmId = orig.PmId;
                    }
                }
            }
            else if (PmId > 0)
            {
                _pm = await Pms.GetAsync(_user.UserId, PmId);
                if (_pm == null) { _error = "Nachricht nicht gefunden."; await LoadListAsync(); return; }
                if (_pm.IsUnread) await Pms.MarkReadAsync(_user.UserId, PmId);
                _conversation = await Pms.ConversationAsync(_user.UserId, _pm);
                if (!_conversation.Any(m => m.PmTextId == _pm.PmTextId)) _conversation.Add(_pm);
                var ctx = await Renderer.ContextAsync(null);
                foreach (var m in _conversation) _bodies[m.PmTextId] = Renderer.Render(m.Message, ctx);
                // Antworten bezieht sich auf die neueste Nachricht des Gesprächspartners
                _replyTo = _conversation.LastOrDefault(m => m.FromUserId != _user.UserId && m.FromUserId > 0 && m.FolderId != PmRepository.Sent);
            }
            else await LoadListAsync();
        }
        finally { _loaded = true; }
    }

    private async Task LoadListAsync() =>
        _list = await Pms.ListAsync(_user!.UserId, _sent ? PmRepository.Sent : PmRepository.Inbox, Math.Max(1, PageQ ?? 1), 25);

    private async Task SendAsync()
    {
        var c = Compose!;
        if (string.IsNullOrWhiteSpace(c.Title)) { _error = "Bitte einen Betreff eingeben."; return; }
        if (string.IsNullOrWhiteSpace(c.Message)) { _error = "Die Nachricht ist leer."; return; }
        if (_user!.IsBanned) { _error = "Gesperrte Konten können keine Nachrichten senden."; return; }
        if (await Pms.SentLastHourAsync(_user.UserId) >= 30 && !_user.IsAdmin) { _error = "Du hast in der letzten Stunde sehr viele Nachrichten gesendet. Bitte warte etwas."; return; }

        var snap = await Cache.GetAsync();
        var recipients = new List<PmRepository.Recipient>();
        foreach (var name in c.To.Split(';', ',').Select(x => x.Trim()).Where(x => x.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Take(5))
        {
            var u = await Users.GetByNameAsync(name);
            if (u == null) { _error = $"Benutzer „{name}“ nicht gefunden."; return; }
            var quota = snap.Groups.GetValueOrDefault(u.UserGroupId)?.PmQuota ?? 0;
            if (quota > 0 && u.PmTotal >= quota && !_user.IsAdmin) { _error = $"Das Postfach von {u.DisplayName} ist voll."; return; }
            recipients.Add(new PmRepository.Recipient(u.UserId, u.DisplayName, u.PmTotal, quota));
        }
        if (recipients.Count == 0) { _error = "Bitte mindestens einen Empfänger angeben."; return; }

        await Pms.SendAsync(_user.UserId, _user.Username, recipients, c.Title, c.Message, c.ParentPmId);
        if (await Mail.IsConfiguredAsync())
        {
            var url = await Mail.AbsoluteUrlAsync("/account/pm");
            foreach (var r in recipients)
                if (await Users.GetAsync(r.UserId) is { } ru)
                    _ = Mail.SendAsync(ru.Email, $"Neue private Nachricht von {_user.Username}", new MailContent(
                        $"Hallo {ru.DisplayName},",
                        new[] { $"{_user.Username} hat dir eine private Nachricht geschickt: „{c.Title}“" },
                        "Nachricht lesen", url,
                        Footnote: "Diese Benachrichtigung kannst du in deinem Benutzerbereich unter „Benachrichtigungen & Abos“ abschalten."));
        }
        Nav.NavigateTo("/account/pm?msg=sent", forceLoad: true);
    }

    private async Task DeleteAsync()
    {
        await Pms.DeleteAsync(_user!.UserId, new[] { PmId });
        Nav.NavigateTo("/account/pm?msg=deleted", forceLoad: true);
    }
}
