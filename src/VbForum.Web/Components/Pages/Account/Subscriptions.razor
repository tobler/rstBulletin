@page "/account/subscriptions"
@attribute [Authorize]
@inject CurrentUser Current
@inject SubscriptionRepository Subs
@inject UserRepository Users
@inject MailService Mail

<PageTitle>Abonnements</PageTitle>

@if (!_loaded) { return; }
<main class="page container">
    <AccountShell User="_user!" Active="subs">
        @if (_message != null) { <div class="alert alert-ok" role="status">@_message</div> }

        <form method="post" action="/theme" class="card card-pad stack" style="gap:8px" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="/account/subscriptions" />
            <h2 class="card-title">Darstellung</h2>
            <div class="row" style="gap:16px;flex-wrap:wrap">
                <label class="check"><input type="radio" name="theme" value="" checked="@(_theme == null)" data-autosubmit />Automatisch (wie Gerät)</label>
                <label class="check"><input type="radio" name="theme" value="light" checked="@(_theme == "light")" data-autosubmit />Hell</label>
                <label class="check"><input type="radio" name="theme" value="dark" checked="@(_theme == "dark")" data-autosubmit />Dunkel</label>
            </div>
            <noscript><button type="submit" class="btn btn-sm">Übernehmen</button></noscript>
            <p class="small muted" style="margin:0">Wird in deinem Konto gespeichert und gilt auf allen Geräten, auf denen du angemeldet bist.</p>
        </form>

        <EditForm Model="Settings" FormName="notify" OnSubmit="SaveAsync" class="card card-pad stack" style="gap:4px" Enhance>
            <h2 class="card-title" style="margin-bottom:10px">Benachrichtigungen</h2>
            @* Sorgt dafür, dass das Formular auch ohne gesetzte Häkchen ankommt *@
            <input type="hidden" name="Settings.Posted" value="true" />
            <label class="toggle-row">Popup anzeigen, wenn eine neue private Nachricht eintrifft <InputCheckbox @bind-Value="Settings!.PmPopup" /></label>
            <label class="toggle-row">E-Mail, wenn eine neue private Nachricht eintrifft <InputCheckbox @bind-Value="Settings.PmEmail" /></label>
            <label class="toggle-row">Eigene Themen und Antworten automatisch abonnieren <InputCheckbox @bind-Value="Settings!.AutoSubscribe" /></label>
            <label class="toggle-row"><span>E-Mail bei neuen Antworten in abonnierten Themen<br /><span class="small muted">Gilt für alle bestehenden und künftigen Abos. Abschalten stoppt auch E-Mails zu neuen Themen aus abonnierten Foren.</span></span> <InputCheckbox @bind-Value="Settings.Email" /></label>
            @if (!_smtp) { <p class="small muted" style="margin:6px 0 0">Hinweis: Der E-Mail-Versand ist im Forum derzeit nicht eingerichtet.</p> }
            <div class="form-actions" style="margin-top:12px"><button type="submit" class="btn btn-primary">Speichern</button></div>
        </EditForm>

        <section class="card">
            <div class="card-head"><h2>Abonnierte Themen</h2><span class="small muted">@_subs.Count</span></div>
            @foreach (var s in _subs)
            {
                <div class="thread-row">
                    <div class="thread-main">
                        <div class="stack" style="gap:2px;min-width:0">
                            <div class="thread-title-line">
                                @if (s.HasNew) { <span class="dot" title="Neue Beiträge"></span> }
                                <a href="/thread/@s.ThreadId/unread" class="thread-title @(s.HasNew ? "unread" : "")">@s.DisplayTitle</a>
                                @if (s.EmailUpdate > 0) { <span class="pill" title="Bei neuen Antworten kommt eine E-Mail">E-Mail</span> }
                            </div>
                            <span class="thread-sub">Letzte Antwort von @HtmlUtil.CleanTitle(s.LastPoster) · @ForumTime.Relative(s.LastPost)</span>
                        </div>
                    </div>
                    <form method="post" action="/thread/@s.ThreadId/subscribe" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="mode" value="@(s.EmailUpdate > 0 ? "silent" : "email")" />
                        <input type="hidden" name="returnUrl" value="/account/subscriptions" />
                        <button type="submit" class="btn btn-sm btn-ghost">@(s.EmailUpdate > 0 ? "Ohne E-Mail" : "Mit E-Mail")</button>
                    </form>
                    <form method="post" action="/thread/@s.ThreadId/subscribe" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="mode" value="off" />
                        <input type="hidden" name="returnUrl" value="/account/subscriptions" />
                        <button type="submit" class="btn btn-sm">Abo beenden</button>
                    </form>
                </div>
            }
            @if (_subs.Count == 0) { <div class="empty">Du hast noch keine Themen abonniert.</div> }
        </section>
    </AccountShell>
</main>

@code {
    public sealed class NotifyInput { public bool AutoSubscribe { get; set; } public bool Email { get; set; } public bool PmPopup { get; set; } public bool PmEmail { get; set; } public bool Posted { get; set; } }

    [SupplyParameterFromForm(FormName = "notify")] public NotifyInput? Settings { get; set; }

    private bool _loaded, _smtp;
    private string? _theme;
    private ForumUser? _user;
    private List<Subscription> _subs = new();
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _user = await Current.GetAsync();
            _smtp = await Mail.IsConfiguredAsync();
            if (Settings == null)
            {
                var row = await Users.GetAsync(_user.UserId);
                var subs = await Subs.ListAsync(_user.UserId);
                // Häkchen zeigt den tatsächlichen Stand: bekommt der Benutzer für irgendein Abo noch Mails?
                var email = subs.Count > 0 ? subs.Any(x => x.EmailUpdate > 0) : row!.AutoSubscribe >= 1;
                Settings = new NotifyInput { AutoSubscribe = row!.AutoSubscribe >= 0, Email = email, PmPopup = row.PmPopup != 0,
                    PmEmail = (row.Options & UserRepository.OptionEmailOnPm) != 0 };
            }
            _subs = await Subs.ListAsync(_user.UserId);
            _theme = VbForum.Web.Infrastructure.Theme.Normalize(await Users.GetPrefAsync(_user.UserId, VbForum.Web.Infrastructure.Theme.Pref));
        }
        finally { _loaded = true; }
    }

    private async Task SaveAsync()
    {
        // vB: -1 = kein Abo, 0 = Abo ohne Mail, 1 = sofortige Mail
        await Users.SetAutoSubscribeAsync(_user!.UserId, !Settings!.AutoSubscribe ? -1 : Settings.Email ? 1 : 0);
        // E-Mail-Einstellung auf alle bestehenden Abos übertragen (vorher galt sie nur für neue)
        await Subs.SetAllEmailAsync(_user.UserId, Settings.Email);
        _subs = await Subs.ListAsync(_user.UserId);
        await Users.SetPmPopupAsync(_user.UserId, Settings.PmPopup);
        await Users.SetOptionAsync(_user.UserId, UserRepository.OptionEmailOnPm, Settings.PmEmail);
        _message = "Einstellungen gespeichert.";
    }
}
