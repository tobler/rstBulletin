@page "/account/subscriptions"
@attribute [Authorize]
@inject CurrentUser Current
@inject SubscriptionRepository Subs
@inject UserRepository Users
@inject BoardCache Cache
@inject MailService Mail

<PageTitle>Abonnements</PageTitle>

@if (!_loaded) { return; }
<main class="page container">
    <AccountShell User="_user!" Active="subs">
        @if (_message != null) { <div class="alert alert-ok" role="status">@_message</div> }

        <form method="post" action="/theme" class="card card-pad stack" style="gap:8px" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="/account/subscriptions" />
            <h2 class="card-title">Darstellung</h2>
            <div class="row" style="gap:16px;flex-wrap:wrap">
                <label class="check"><input type="radio" name="theme" value="" checked="@(_theme == null)" data-autosubmit />Automatisch (wie Gerät)</label>
                <label class="check"><input type="radio" name="theme" value="light" checked="@(_theme == "light")" data-autosubmit />Hell</label>
                <label class="check"><input type="radio" name="theme" value="dark" checked="@(_theme == "dark")" data-autosubmit />Dunkel</label>
            </div>
            <noscript><button type="submit" class="btn btn-sm">Übernehmen</button></noscript>
            <p class="small muted" style="margin:0">Wird in deinem Konto gespeichert und gilt auf allen Geräten, auf denen du angemeldet bist.</p>
        </form>

        @if (_canInvisible)
        {
            <form method="post" action="/prefs/invisible" class="card card-pad stack" style="gap:8px" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="/account/subscriptions?saved=invisible" />
                <h2 class="card-title">Online-Status</h2>
                <div class="row" style="gap:16px;flex-wrap:wrap">
                    <label class="check"><input type="radio" name="invisible" value="0" checked="@(!_invisible)" data-autosubmit />Sichtbar</label>
                    <label class="check"><input type="radio" name="invisible" value="1" checked="@_invisible" data-autosubmit />Verbergen</label>
                </div>
                <noscript><button type="submit" class="btn btn-sm">Übernehmen</button></noscript>
                <p class="small muted" style="margin:0">Verborgen: Andere sehen nicht, wann du zuletzt online warst, und du zählst nicht bei „Gerade online“. Moderatoren und Administratoren sehen es weiterhin.</p>
            </form>
        }

        <form method="post" action="/prefs/postorder" class="card card-pad stack" style="gap:8px" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="/account/subscriptions?saved=order" />
            <h2 class="card-title">Reihenfolge der Beiträge in Themen</h2>
            <div class="row" style="gap:16px;flex-wrap:wrap">
                <label class="check"><input type="radio" name="order" value="asc" checked="@(!_orderDesc)" data-autosubmit />Älteste zuerst</label>
                <label class="check"><input type="radio" name="order" value="desc" checked="@_orderDesc" data-autosubmit />Neueste zuerst</label>
            </div>
            <noscript><button type="submit" class="btn btn-sm">Übernehmen</button></noscript>
            <p class="small muted" style="margin:0">Gilt für alle Themen. Im Thema selbst kannst du weiterhin jederzeit umschalten.</p>
        </form>

        <EditForm Model="Settings" FormName="notify" OnSubmit="SaveAsync" class="card card-pad stack" style="gap:4px" Enhance>
            <h2 class="card-title" style="margin-bottom:10px">Benachrichtigungen</h2>
            @* Sorgt dafür, dass das Formular auch ohne gesetzte Häkchen ankommt *@
            <input type="hidden" name="Settings.Posted" value="true" />
            <label class="toggle-row">Popup anzeigen, wenn eine neue private Nachricht eintrifft <InputCheckbox @bind-Value="Settings!.PmPopup" /></label>
            <label class="toggle-row">E-Mail, wenn eine neue private Nachricht eintrifft <InputCheckbox @bind-Value="Settings.PmEmail" /></label>
            <label class="toggle-row">Eigene Themen und Antworten automatisch abonnieren <InputCheckbox @bind-Value="Settings!.AutoSubscribe" /></label>
            <label class="toggle-row"><span>E-Mail bei neuen Antworten in abonnierten Themen<br /><span class="small muted">Gilt für alle bestehenden und künftigen Abos. Abschalten stoppt auch E-Mails zu neuen Themen aus abonnierten Foren.</span></span> <InputCheckbox @bind-Value="Settings.Email" /></label>
            @if (!_smtp) { <p class="small muted" style="margin:6px 0 0">Hinweis: Der E-Mail-Versand ist im Forum derzeit nicht eingerichtet.</p> }
            <div class="form-actions" style="margin-top:12px"><button type="submit" class="btn btn-primary">Speichern</button></div>
        </EditForm>

        <section class="card card-pad stack" style="gap:8px">
            <div class="row" style="justify-content:space-between">
                <h2 class="card-title" style="margin:0">Abonnierte Themen</h2>
                <a class="btn btn-sm btn-primary" href="/subscriptions">Abos anzeigen (@_subCount)</a>
            </div>
            <p class="small muted" style="margin:0">Deine abonnierten Themen findest du jetzt direkt oben in der Navigation unter „Abos“.</p>
        </section>

        <section class="card card-pad stack" style="gap:10px" id="ignorieren">
            <h2 class="card-title" style="margin:0">Ignorier-Liste</h2>
            <p class="small muted" style="margin:0">Beiträge dieser Benutzer werden eingeklappt, und sie können dir keine privaten Nachrichten schicken.</p>
            @if (_ignoreMsg != null) { <div class="alert @(IgnoreQ is "added" or "removed" ? "alert-ok" : "alert-err")">@_ignoreMsg</div> }
            @foreach (var (id, name) in _ignored)
            {
                <div class="row" style="justify-content:space-between;border-top:1px solid var(--border);padding-top:8px">
                    <a href="@Links.User(id, name)">@name</a>
                    <form method="post" action="/ignore/@id" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="returnUrl" value="/account/subscriptions#ignorieren" />
                        <button type="submit" class="btn btn-sm">Entfernen</button>
                    </form>
                </div>
            }
            @if (_ignored.Count == 0) { <p class="muted" style="margin:0">Du ignorierst niemanden.</p> }
            <form method="post" action="/ignore/0" class="row" style="gap:8px">
                <AntiforgeryToken />
                <input type="hidden" name="action" value="add" />
                <input type="hidden" name="returnUrl" value="/account/subscriptions#ignorieren" />
                <label for="ign-name" class="sr-only">Benutzername</label>
                <input id="ign-name" class="input" name="name" placeholder="Benutzername" style="flex:1 1 200px" required />
                <button type="submit" class="btn btn-sm">Ignorieren</button>
            </form>
        </section>
    </AccountShell>
</main>

@code {
    public sealed class NotifyInput { public bool AutoSubscribe { get; set; } public bool Email { get; set; } public bool PmPopup { get; set; } public bool PmEmail { get; set; } public bool Posted { get; set; } }

    [SupplyParameterFromForm(FormName = "notify")] public NotifyInput? Settings { get; set; }

    private bool _loaded, _smtp;
    private string? _theme;
    private ForumUser? _user;
    private int _subCount;
    private bool _orderDesc, _canInvisible, _invisible;
    [SupplyParameterFromQuery(Name = "saved")] public string? SavedQ { get; set; }
    private List<(long UserId, string Name)> _ignored = new();
    private string? _ignoreMsg;
    [SupplyParameterFromQuery(Name = "ignore")] public string? IgnoreQ { get; set; }
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _user = await Current.GetAsync();
            _smtp = await Mail.IsConfiguredAsync();
            if (Settings == null)
            {
                var row = await Users.GetAsync(_user.UserId);
                var subs = await Subs.ListAsync(_user.UserId);
                // Häkchen zeigt den tatsächlichen Stand: bekommt der Benutzer für irgendein Abo noch Mails?
                var email = subs.Count > 0 ? subs.Any(x => x.EmailUpdate > 0) : row!.AutoSubscribe >= 1;
                Settings = new NotifyInput { AutoSubscribe = row!.AutoSubscribe >= 0, Email = email, PmPopup = row.PmPopup != 0,
                    PmEmail = (row.Options & UserRepository.OptionEmailOnPm) != 0 };
            }
            _subCount = (await Subs.ListAsync(_user.UserId)).Count;
            _orderDesc = await Users.GetPrefAsync(_user.UserId, VbForum.Web.Infrastructure.PostOrder.Pref) == "desc";
            if (SavedQ == "order") _message = "Reihenfolge gespeichert.";
            if (SavedQ == "invisible") _message = "Online-Status gespeichert.";
            _canInvisible = new Permissions(await Cache.GetAsync()).CanGoInvisible(_user);
            _invisible = (await Users.GetAsync(_user.UserId)) is { } me && UserRepository.IsInvisible(me);
            _ignored = await Users.NamesAsync(await Users.IgnoreListAsync(_user.UserId));
            _ignoreMsg = IgnoreQ switch
            {
                "added" => "Benutzer wird jetzt ignoriert.",
                "removed" => "Benutzer von der Liste entfernt.",
                "notfound" => "Diesen Benutzer gibt es nicht.",
                "self" => "Dich selbst kannst du nicht ignorieren.",
                "staff" => "Moderatoren und Administratoren können nicht ignoriert werden.",
                _ => null,
            };
            _theme = VbForum.Web.Infrastructure.Theme.Normalize(await Users.GetPrefAsync(_user.UserId, VbForum.Web.Infrastructure.Theme.Pref));
        }
        finally { _loaded = true; }
    }

    private async Task SaveAsync()
    {
        // vB: -1 = kein Abo, 0 = Abo ohne Mail, 1 = sofortige Mail
        await Users.SetAutoSubscribeAsync(_user!.UserId, !Settings!.AutoSubscribe ? -1 : Settings.Email ? 1 : 0);
        // E-Mail-Einstellung auf alle bestehenden Abos übertragen (vorher galt sie nur für neue)
        await Subs.SetAllEmailAsync(_user.UserId, Settings.Email);
        await Users.SetPmPopupAsync(_user.UserId, Settings.PmPopup);
        await Users.SetOptionAsync(_user.UserId, UserRepository.OptionEmailOnPm, Settings.PmEmail);
        _message = "Einstellungen gespeichert.";
    }
}
