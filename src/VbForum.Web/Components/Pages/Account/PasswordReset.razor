@page "/account/forgot"
@page "/account/reset"
@page "/account/confirm"
@inject AuthService Auth
@inject MailService Mail
@inject NavigationManager Nav

<PageTitle>@_title</PageTitle>

<main class="page container" style="align-items:center">
    <div class="stack" style="width:min(440px,100%);gap:20px">
        <div class="page-head"><h1>@_title</h1></div>

        @if (_mode == "confirm")
        {
            <div class="card card-pad stack" style="gap:10px">
                @if (_confirmed) { <p style="margin:0">Danke! Deine E-Mail-Adresse ist bestätigt.</p><p style="margin:0"><a class="btn btn-primary" href="/login?msg=confirmed">Anmelden</a></p> }
                else { <p style="margin:0">Der Bestätigungslink ist ungültig oder abgelaufen.</p> }
            </div>
        }
        else if (_mode == "forgot")
        {
            @if (_sent)
            {
                <div class="alert alert-ok">Falls ein Konto mit dieser Adresse existiert, haben wir dir einen Link geschickt. Schau auch im Spam-Ordner nach.</div>
            }
            else
            {
                @if (!_smtp) { <div class="alert alert-warn">Der E-Mail-Versand ist noch nicht eingerichtet. Bitte wende dich an die Administration.</div> }
                <EditForm Model="Input" FormName="forgot" OnSubmit="ForgotAsync" class="card card-pad stack" Enhance>
                    <p class="muted" style="margin:0">Gib die E-Mail-Adresse deines Kontos ein. Wir schicken dir einen Link, mit dem du ein neues Passwort festlegen kannst.</p>
                    <div class="field">
                        <label for="f-mail">E-Mail-Adresse</label>
                        <InputText id="f-mail" type="email" @bind-Value="Input.Email" autocomplete="email" />
                    </div>
                    <button type="submit" class="btn btn-primary">Link anfordern</button>
                </EditForm>
            }
        }
        else
        {
            <EditForm Model="Input" FormName="reset" OnSubmit="ResetAsync" class="card card-pad stack" Enhance>
                @if (_error != null) { <div class="alert alert-err" role="alert">@_error</div> }
                <input type="hidden" name="Input.Token" value="@(Input.Token ?? Token)" />
                <div class="field">
                    <label for="r-pw">Neues Passwort</label>
                    <InputText id="r-pw" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
                    <span class="hint">Mindestens 8 Zeichen.</span>
                </div>
                <div class="field">
                    <label for="r-pw2">Wiederholen</label>
                    <InputText id="r-pw2" type="password" @bind-Value="Input.Password2" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary">Passwort speichern</button>
            </EditForm>
        }
    </div>
</main>

@code {
    public sealed class ResetInput
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Password2 { get; set; } = "";
        public string? Token { get; set; }
    }

    [SupplyParameterFromForm(Name = "Input")] public ResetInput? InputForm { get; set; }
    private ResetInput Input => InputForm ??= new();
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string _mode = "forgot", _title = "Passwort vergessen";
    private string? _error;
    private bool _sent, _confirmed, _smtp;

    protected override async Task OnInitializedAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        _mode = path.StartsWith("account/reset") ? "reset" : path.StartsWith("account/confirm") ? "confirm" : "forgot";
        _title = _mode switch { "reset" => "Neues Passwort festlegen", "confirm" => "E-Mail bestätigen", _ => "Passwort vergessen" };
        _smtp = await Mail.IsConfiguredAsync();
        if (_mode == "confirm" && !string.IsNullOrEmpty(Token)) _confirmed = await Auth.ConfirmAsync(Token);
    }

    private async Task ForgotAsync()
    {
        await Auth.RequestResetAsync(Input.Email);
        _sent = true;
    }

    private async Task ResetAsync()
    {
        if (Input.Password != Input.Password2) { _error = "Die Passwörter stimmen nicht überein."; return; }
        var err = await Auth.ResetAsync(Input.Token ?? Token ?? "", Input.Password);
        if (err != null) { _error = err; return; }
        Nav.NavigateTo("/login?msg=reset", forceLoad: true);
    }
}
